# --- Import libraries ---
from zxcvbn import zxcvbn
import itertools  # <-- added here for optional wordlist generator


# --- Function 1: Analyze Password Strength ---
def analyze_password_strength(password):
    result = zxcvbn(password)
    
    print("\n🔹 Password Analysis Result 🔹")
    print(f"Password: {password}")
    print(f"Score (0-4): {result['score']}")
    
    strength_levels = ["Very Weak", "Weak", "Fair", "Good", "Strong"]
    print(f"Strength: {strength_levels[result['score']]}")
    
    print("\nFeedback:")
    print(result['feedback']['warning'] or "No major issues found.")
    if result['feedback']['suggestions']:
        for suggestion in result['feedback']['suggestions']:
            print(f"- {suggestion}")
    
    print("\nEstimated Crack Time:")
    print(result['crack_times_display']['offline_slow_hashing_1e4_per_second'])


# --- Function 2 (Optional): Custom Wordlist Generator ---
def generate_custom_wordlist(words, max_length=3):
    wordlist = []
    for i in range(1, max_length + 1):
        for combo in itertools.permutations(words, i):
            wordlist.append(''.join(combo))
    return wordlist


# --- Main Program ---
print("🔐 Password Strength Analyzer 🔐\n")
password = input("Enter a password to test: ")
analyze_password_strength(password)

# --- Option 5 (Optional Feature) ---
choice = input("\nDo you want to generate a custom wordlist? (yes/no): ").lower()
if choice == "yes":
    user_words = input("Enter personal words (comma separated): ").split(',')
    wordlist = generate_custom_wordlist([w.strip() for w in user_words])
    print(f"\nGenerated {len(wordlist)} custom word combinations:")
    print(wordlist[:10])  # show only first 10
